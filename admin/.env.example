# Copy to .env.local (Next.js) / .env (Prisma CLI) for local development.
# On Vercel these come from Storage → Postgres (Neon) and Settings → Environment Variables.

# --- Database (Vercel Postgres / Neon sets all of these when you connect it) ---
# Pooled connection used by the app at runtime (Prisma).
POSTGRES_PRISMA_URL="postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection used by `prisma migrate` (migrations can't run through the pooler).
POSTGRES_URL_NON_POOLING="postgres://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Local alternative to the two above, e.g. a Postgres on your machine:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beaut"

# --- Dashboard sign-in (required) ---
ADMIN_PASSWORD="choose-a-long-password"

# --- Booking confirmation emails via resend.com (optional) ---
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Beaut Studio <bookings@yourdomain.com>"

# --- Studio time zone for "today" / "already passed" (optional, default Africa/Lagos) ---
# STUDIO_TIMEZONE="Africa/Lagos"

# --- Privacy policy (/privacy) contact details (recommended for Google Play) ---
# BUSINESS_NAME="Your registered business name"
# CONTACT_EMAIL="privacy@yourdomain.com"
